{
  "scripts": {
    "smoke:pipelines": "node scripts/smoke_check_pipelines.mjs",
    "typecheck:frontend": "npm --prefix Frontend exec tsc -- --noEmit -p Frontend/tsconfig.app.json",
    "rigorous:calibrate": "python backend/scripts/calibrate_rigorous.py --races bahrain abu_dhabi --iterations 300 --trials 12 --seed 42 --in-params backend/data/rigorous_model_params.v1.json --out-params backend/data/rigorous_model_params.v1.calibrated.json --report backend/reports/rigorous_calibration_report.json",
    "rigorous:validate": "python backend/scripts/backtest_rigorous.py --iterations 400 --races bahrain abu_dhabi --seeds 17 42 --params-file backend/data/rigorous_model_params.v1.calibrated.json --out backend/reports/rigorous_backtest_report_calibrated.json --require-reproducible --max-runtime-ms 900 --max-convergence-l1 0.25 && npm run smoke:pipelines",
    "rigorous:concordance": "python backend/scripts/run_concordance.py",
    "gold:build": "python backend/scripts/build_gold_dataset.py",
    "gold:audit": "python backend/scripts/audit_gold_dataset.py --root backend/data/gold/v1 --out backend/reports/gold_event_coverage_report.json",
    "gold:freeze": "python backend/scripts/freeze_gold_dataset.py --root backend/data/gold/v1 --version v1 --out backend/data/gold/v1/gold_manifest.json"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "node-cron": "^4.2.1"
  }
}
